{
    "version": "9.9.33.260813",
    "description": "An instant messaging software service developed by Tencent (NT architecture, portable extraction of the official installer)",
    "homepage": "https://im.qq.com/pcqq/index.shtml",
    "license": {
        "identifier": "Proprietary",
        "url": "https://ti.qq.com/agreement/index.html"
    },
    "notes": [
        "This manifest extracts the official NSIS installer into a portable layout; no admin rights are needed.",
        "Chat data (nt_qq) is redirected to $persist_dir\\Tencent Files via a junction at %USERPROFILE%\\Documents\\Tencent Files. Account settings/cache remain at %APPDATA%\\Tencent\\QQ.",
        "The junction is removed on uninstall, but the data under $persist_dir is kept.",
        "If %USERPROFILE%\\Documents\\Tencent Files already exists as a real folder (e.g. from an installed QQ), the junction is skipped and data stays in place.",
        "Account settings/cache (%APPDATA%\\Tencent\\QQ and QQNT) are redirected to $persist_dir\\appdata_QQ via junctions, so they survive OS reinstalls.",
        "Existing data is migrated automatically on install; the original folder is kept as .bak-<timestamp> for rollback - delete it manually after verifying.",
        "To avoid the in-app self-updater bypassing Scoop version management, disable auto-update in QQ settings.",
        "Official releases do not provide hash files, so after autoupdate detects a new version the hash must be filled in manually."
    ],
    "architecture": {
        "64bit": {
            "url": "https://qqdl.gtimg.cn/qqfile/QQNT/9.9.33/release/497e2f1f/QQ_9.9.33_260813_x64_01.exe#/dl.7z",
            "hash": "b25c0d3ce9df764074a9118d0ded927e1b2d7ebf60e306112e8df18a040ec492"
        },
        "32bit": {
            "url": "https://qqdl.gtimg.cn/qqfile/QQNT/9.9.33/release/497e2f1f/QQ_9.9.33_260813_x86_01.exe#/dl.7z",
            "hash": "fd7214c7a70a6e0eb46781e0d653d5c56b0d496d2f710b4d5c07939c40b73be6"
        },
        "arm64": {
            "url": "https://qqdl.gtimg.cn/qqfile/QQNT/9.9.33/release/497e2f1f/QQ_9.9.33_260813_arm64_01.exe#/dl.7z",
            "hash": "ee77d6d8bdfc4f4c9bf9c6d2521322ff410d2614a7e8ba005aaa9703fc9ef174"
        }
    },
    "extract_dir": "Files",
    "pre_install": [
        "Stop-Process -Name 'QQ', 'QQEX' -Force -ErrorAction SilentlyContinue"
    ],
    "installer": {
        "script": [
            "Remove-Item \"$dir\\Uninstall.exe\" -Force -ErrorAction SilentlyContinue",
            "function Ensure-LinkedData {",
            "    param($Target, $Link)",
            "    if (Test-Path $Link) {",
            "        $item = Get-Item $Link -Force",
            "        if ($item.LinkType -eq 'Junction') { Write-Host \"Already linked: $Link\"; return }",
            "        $bak = \"$Link.bak-$([DateTime]::Now.ToString('yyyyMMddHHmmss'))\"",
            "        New-Item -ItemType Directory -Path $Target -Force | Out-Null",
            "        Write-Host \"Migrating existing data: $Link -> $Target\"",
            "        robocopy $Link $Target /E /COPY:DAT /DCOPY:DAT /R:2 /W:1 /NFL /NDL /NJH /NJS /NP | Out-Null",
            "        if ($LASTEXITCODE -lt 8) {",
            "            Rename-Item -Path $Link -NewName (Split-Path $bak -Leaf) -Force",
            "            New-Item -ItemType Junction -Path $Link -Target $Target | Out-Null",
            "            Write-Host \"Data migrated. Original kept at $bak - delete it manually after verifying.\"",
            "        } else { Write-Host \"WARNING: migration failed (robocopy $LASTEXITCODE); junction skipped, data kept in place.\" }",
            "        return",
            "    }",
            "    New-Item -ItemType Directory -Path $Target -Force | Out-Null",
            "    New-Item -ItemType Junction -Path $Link -Target $Target | Out-Null",
            "    Write-Host \"Linked: $Link -> $Target\"",
            "}",
            "Ensure-LinkedData \"$persist_dir\\appdata_QQ\" \"$env:APPDATA\\Tencent\\QQ\"",
            "Ensure-LinkedData \"$persist_dir\\appdata_QQNT\" \"$env:APPDATA\\Tencent\\QQNT\"",
            "$data_dir = \"$env:USERPROFILE\\Documents\\Tencent Files\"",
            "$persist_data = \"$persist_dir\\Tencent Files\"",
            "if (!(Test-Path $persist_data)) { New-Item -ItemType Directory -Path $persist_data -Force | Out-Null }",
            "if (!(Test-Path $data_dir)) { New-Item -ItemType Junction -Path $data_dir -Target $persist_data | Out-Null }",
            "elseif (!(Get-Item $data_dir).LinkType) { Write-Host \"NOTE: $data_dir exists as a real folder, junction skipped.\" }"
        ]
    },
    "uninstaller": {
        "script": [
            "$links = @(\"$env:APPDATA\\Tencent\\QQ\", \"$env:APPDATA\\Tencent\\QQNT\")",
            "foreach ($l in $links) { if ((Test-Path $l) -and (Get-Item $l -Force).LinkType -eq 'Junction') { (Get-Item $l -Force).Delete() } }",
            "$data_dir = \"$env:USERPROFILE\\Documents\\Tencent Files\"",
            "if ((Test-Path $data_dir) -and (Get-Item $data_dir).LinkType -eq 'Junction') { (Get-Item $data_dir).Delete() }"
        ]
    },
    "bin": [
        [
            "QQ.exe",
            "qq"
        ]
    ],
    "shortcuts": [
        [
            "QQ.exe",
            "QQ"
        ]
    ],
    "checkver": {
        "url": "https://im.qq.com/proxy/domain/cdn-go.cn/qq-web/im.qq.com_new/latest/rainbow/pcConfig.json",
        "regex": "Windows\":{\"version\":\"([\\d.]+)\",\"updateDate\":\"20([\\d]+)-([\\d]+)-([\\d]+)\".*gtimg\\.cn\\/([\\w\\-\\/.]+x86_01.exe)\".*gtimg\\.cn\\/([\\w\\-\\/.]+x64_01.exe)\".*gtimg\\.cn\\/([\\w\\-\\/.]+arm64_01.exe)\"",
        "replace": "${1}.${2}${3}${4}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://qqdl.gtimg.cn/$match6#/dl.7z"
            },
            "32bit": {
                "url": "https://qqdl.gtimg.cn/$match5#/dl.7z"
            },
            "arm64": {
                "url": "https://qqdl.gtimg.cn/$match7#/dl.7z"
            }
        }
    }
}
