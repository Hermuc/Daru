{
    "version": "3.4.3.2",
    "description": "一个功能强大使用简单的截图/贴图/录屏工具（便携版） | A powerful and simple screenshot/stick/screen recording tool (portable)",
    "homepage": "https://pixpin.cn",
    "license": {
        "identifier": "Freemium",
        "url": "https://pixpin.cn/docs/policy/tos_zh_CN.html"
    },
    "architecture": {
        "64bit": {
            "url": "https://down.pixpin.cn/PixPin_win_3.4.3.2.zip",
            "hash": "1ed2b048f7e1468cdd3dc869c3db0653d9308ffe4f48fb42091b0b559a90b211"
        }
    },
    "extract_dir": "PixPin",
    "pre_install": [
        "# 关闭正在运行的 PixPin，避免更新时文件占用导致解压/切换失败",
        "Stop-Process -Name 'PixPin', 'PixPinAuxiliary' -Force -ErrorAction SilentlyContinue"
    ],
    "post_install": [
        "# 借鉴 dorado/pixpin：写入 PixPinConfig.json 禁用应用内自动更新（仅首次安装时写入，已有配置则跳过）",
        "$configPath = \"$persist_dir\\Config\\PixPinConfig.json\"",
        "if (Test-Path $configPath) { return }",
        "$timestamp = [DateTimeOffset]::Now.ToUnixTimeSeconds()",
        "$content = '{\"System.Update.UpgradeMode#s.win\":{\"t\":' + $timestamp + ',\"v\":0}}'",
        "$content | Set-Content -Path $configPath -Encoding UTF8"
    ],
    "persist": [
        "Config",
        "Data",
        "History",
        "Contents",
        "LocalStorage.data"
    ],
    "conflicts": [
        "PixPin.Beta",
        "abyss/PixPin.PixPin",
        "abyss/PixPin.PixPin.Beta"
    ],
    "bin": "PixPin.exe",
    "shortcuts": [
        [
            "PixPin.exe",
            "PixPin"
        ]
    ],
    "notes": [
        "便携版：用户数据（Config/Data/History/Contents/LocalStorage.data）经 persist 保存至 Scoop\\persist\\PixPin，更新不丢失；",
        "若从安装版迁移，旧数据位于 %LocalAppData%\\PixPin，可自行手动备份。",
        "首次安装时自动写入 PixPinConfig.json 禁用应用内自动更新（UpgradeMode=0，借鉴 dorado）；已有配置则保持不动。"
    ],
    "checkver": {
        "url": "https://pixpin.cn/download/",
        "regex": "PixPin_win_([\\d.]+)\\.zip"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://down.pixpin.cn/PixPin_win_$version.zip"
            }
        }
    }
}
