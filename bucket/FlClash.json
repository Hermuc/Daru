{
    "version": "0.8.96",
    "description": "A multi-platform proxy client based on ClashMeta, simple and easy to use, open-source and ad-free.",
    "homepage": "https://github.com/chen08209/FlClash",
    "license": {
        "identifier": "GPL-3.0-only",
        "url": "https://github.com/chen08209/FlClash/blob/main/LICENSE"
    },
    "notes": [
        "用户数据（订阅 profiles、config.yaml、设置 shared_preferences.json、database.sqlite 等）位于 %APPDATA%\\com.follow\\clash，",
        "已通过 junction 重定向至 $persist_dir（appdata / localappdata），重装系统后 scoop install 即自动恢复；",
        "首次安装/更新时自动迁移既有数据，原目录保留为 .bak-<时间戳> 回滚点，确认无误后可手动删除；",
        "卸载仅移除 junction，$persist_dir 下数据保留。",
        "Once you set up TUN mode successfully, the older versions of FlClash may be hard to remove by running 'scoop cleanup FlClash'.",
        "In that case, try running the following command with privilege:",
        "sc.exe config FlClashHelperService binPath=\"$dir\\FlClashHelperService.exe\"",
        "Also, FlClash may be hard to uninstall due to the running FlClashHelperService; stop it first with 'sc.exe stop FlClashHelperService' (privilege required)."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/chen08209/FlClash/releases/download/v0.8.96/FlClash-0.8.96-windows-amd64.zip",
            "hash": "94a6683558e5dda46559b30f06730a71cb8a0dfb812e70288fde2be9a96fda70"
        },
        "arm64": {
            "url": "https://github.com/chen08209/FlClash/releases/download/v0.8.96/FlClash-0.8.96-windows-arm64.zip",
            "hash": "ceecb47b9f1db3c840f25ccf0c233c434508d2363d1cd82b400e1ccabb920711"
        }
    },
    "pre_install": [
        "# 关闭正在运行的客户端与 TUN 辅助进程，避免更新/迁移时文件占用",
        "Stop-Process -Name 'FlClash', 'FlClashCore', 'FlClashHelperService' -Force -ErrorAction SilentlyContinue"
    ],
    "installer": {
        "script": [
            "# 数据目录 Junction 化：FlClash 为 Flutter 应用，数据固定落于 %APPDATA%/com.follow/clash 与 %LOCALAPPDATA%/com.follow/clash，",
            "# 无法经 persist 字段链接（不在版本目录内），故参照微信/QQ 模式重定向至 $persist_dir，重装系统后数据不丢失",
            "function Ensure-LinkedData {",
            "    param($Target, $Link)",
            "    if (Test-Path $Link) {",
            "        $item = Get-Item $Link -Force",
            "        if ($item.LinkType -eq 'Junction') { Write-Host \"Already linked: $Link\"; return }",
            "        $bak = \"$Link.bak-$([DateTime]::Now.ToString('yyyyMMddHHmmss'))\"",
            "        New-Item -ItemType Directory -Path $Target -Force | Out-Null",
            "        Write-Host \"Migrating existing data: $Link -> $Target\"",
            "        robocopy $Link $Target /E /COPY:DAT /DCOPY:DAT /R:2 /W:1 /NFL /NDL /NJH /NJS /NP | Out-Null",
            "        if ($LASTEXITCODE -lt 8) {",
            "            Rename-Item -Path $Link -NewName (Split-Path $bak -Leaf) -Force",
            "            New-Item -ItemType Junction -Path $Link -Target $Target | Out-Null",
            "            Write-Host \"Data migrated. Original kept at $bak - delete it manually after verifying.\"",
            "        } else { Write-Host \"WARNING: migration failed (robocopy $LASTEXITCODE); junction skipped, data kept in place.\" }",
            "        return",
            "    }",
            "    New-Item -ItemType Directory -Path $Target -Force | Out-Null",
            "    New-Item -ItemType Junction -Path $Link -Target $Target | Out-Null",
            "    Write-Host \"Linked: $Link -> $Target\"",
            "}",
            "Ensure-LinkedData \"$persist_dir\\appdata\" \"$env:APPDATA\\com.follow\\clash\"",
            "Ensure-LinkedData \"$persist_dir\\localappdata\" \"$env:LOCALAPPDATA\\com.follow\\clash\""
        ]
    },
    "pre_uninstall": [
        "# 移除数据目录 junction（保留 $persist_dir 数据）；卸载后原目录不再指向 persist",
        "foreach ($l in @(\"$env:APPDATA\\com.follow\\clash\", \"$env:LOCALAPPDATA\\com.follow\\clash\")) {",
        "    if ((Test-Path $l) -and ((Get-Item $l -Force).LinkType -eq 'Junction')) { (Get-Item $l -Force).Delete() }",
        "}"
    ],
    "bin": "FlClash.exe",
    "shortcuts": [
        [
            "FlClash.exe",
            "FlClash"
        ]
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/chen08209/FlClash/releases/download/v$version/FlClash-$version-windows-amd64.zip"
            },
            "arm64": {
                "url": "https://github.com/chen08209/FlClash/releases/download/v$version/FlClash-$version-windows-arm64.zip"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS"
        }
    }
}
