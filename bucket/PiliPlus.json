{
    "version": "2.1.2.2",
    "description": "使用 Flutter 开发的 BiliBili 第三方客户端 | A third-party BiliBili client developed using Flutter",
    "homepage": "https://github.com/bggRGjQaUbCoE/PiliPlus",
    "license": {
        "identifier": "GPL-3.0-or-later"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/bggRGjQaUbCoE/PiliPlus/releases/download/2.1.2.2/PiliPlus_windows_2.1.2+5277_x64_portable.zip",
            "hash": "ea476ce876c398704207e8be8c70a64b029ff387f8ea8958918d6c257b12d401"
        }
    },
    "extract_dir": "PiliPlus-Win",
    "extract_to": "app",
    "pre_install": [
        "# 关闭可能正在运行的旧版本进程，避免迁移时文件占用",
        "Stop-Process -Name 'piliplus' -Force -ErrorAction SilentlyContinue",
        "# 数据目录 Junction 化：AppData 路径 -> persist（首次/迁移时自动搬运已有数据）",
        "$link = \"$env:AppData\\com.example\\piliplus\"",
        "$dst = \"$persist_dir\\AppData\\Roaming\\com.example\\piliplus\"",
        "if (Test-Path $link) {",
        "    $item = Get-Item $link -Force",
        "    if ($item.LinkType -eq 'Junction') {",
        "        $old = $item.Target",
        "        if ($old -ne $dst) {",
        "            robocopy $old $dst /E /MOVE /R:1 /W:1 /NP /NFL /NDL /NJH /NJS | Out-Null",
        "            if ($LASTEXITCODE -ge 8) { Write-Host \"WARNING: migration failed (robocopy $LASTEXITCODE); keeping existing link.\" }",
        "            else { (Get-Item $link -Force).Delete() }",
        "        }",
        "    } else {",
        "        robocopy $link $dst /E /MOVE /R:1 /W:1 /NP /NFL /NDL /NJH /NJS | Out-Null",
        "        if ($LASTEXITCODE -ge 8) { Write-Host \"WARNING: migration failed (robocopy $LASTEXITCODE); original data kept in place.\" }",
        "    }",
        "}"
    ],
    "post_install": [
        "$link = \"$env:AppData\\com.example\\piliplus\"",
        "$dst = \"$persist_dir\\AppData\\Roaming\\com.example\\piliplus\"",
        "if (!(Test-Path $link)) { New-Item -ItemType Junction -Path $link -Target $dst | Out-Null }",
        "elseif ((Get-Item $link -Force).LinkType -eq 'Junction') { Write-Host \"Already linked: $link\" }",
        "else { Write-Host \"WARNING: $link exists as a real folder; junction skipped.\" }"
    ],
    "pre_uninstall": [
        "Stop-Process -Name 'piliplus' -Force -ErrorAction SilentlyContinue",
        "if ((Test-Path \"$env:AppData\\com.example\\piliplus\") -and ((Get-Item \"$env:AppData\\com.example\\piliplus\" -Force).LinkType -eq 'Junction')) { (Get-Item \"$env:AppData\\com.example\\piliplus\" -Force).Delete() }"
    ],
    "shortcuts": [
        [
            "app\\piliplus.exe",
            "PiliPlus"
        ]
    ],
    "persist": "AppData\\Roaming\\com.example\\piliplus",
    "checkver": {
        "url": "https://api.github.com/repos/bggRGjQaUbCoE/PiliPlus/releases/latest",
        "regex": "/download/([^/]+)/PiliPlus_windows_(?<main>[\\d.]+)%2B(?<build>\\d+)_x64_portable.zip"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/bggRGjQaUbCoE/PiliPlus/releases/download/$version/PiliPlus_windows_$matchMain+$matchBuild_x64_portable.zip"
            }
        }
    }
}
