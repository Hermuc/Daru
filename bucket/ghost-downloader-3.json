{
    "version": "4.3.1",
    "description": "An AI-powered cross-platform file downloader built with Flutter-style UI on PySide6 | 基于 PySide6 的跨平台 AI 文件下载器",
    "homepage": "https://github.com/XiaoYouChR/Ghost-Downloader-3",
    "license": "GPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://github.com/XiaoYouChR/Ghost-Downloader-3/releases/download/v4.3.1/Ghost-Downloader-v4.3.1-Windows-x86_64.zip",
            "hash": "49ebbc736490de6fdef20fc544ef65e95cdb1291cd7fa7cf93b6a2468964c7e2"
        }
    },
    "extract_dir": "dist\\Ghost-Downloader-3.dist",
    "post_install": [
        "# Scoop 更新后默认保留旧版本目录，此处自动清理（仅保留当前版本与 _*.old 备份）",
        "Get-ChildItem -LiteralPath (Split-Path $dir -Parent) -Directory | Where-Object { $_.Name -ne (Split-Path $dir -Leaf) -and $_.Name -ne 'current' -and $_.Name -notmatch '^_' } | Remove-Item -Recurse -Force -Confirm:$false -ErrorAction SilentlyContinue"
    ],
    "persist": "GhostDownloader",
    "notes": [
        "便携模式：exe 同级存在 GhostDownloader 目录（经 persist 链接至 Scoop\\persist\\ghost-downloader-3），",
        "配置（UserConfig.json）、任务列表（tasks.jsonl）与组件（FFmpeg/M3U8DL/YtDlp）均存于该目录，",
        "更新不丢失，可随程序目录整体迁移。"
    ],
    "shortcuts": [
        [
            "Ghost-Downloader-3.exe",
            "Ghost Downloader 3"
        ]
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/XiaoYouChR/Ghost-Downloader-3/releases/download/v$version/Ghost-Downloader-v$version-Windows-x86_64.zip"
            }
        }
    }
}
