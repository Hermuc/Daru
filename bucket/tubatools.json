{
    "version": "1.5.0",
    "description": "图吧工具箱 winUI3 版，现代化的 PC 硬件检测与系统维护工具集 | Modern toolkit for PC hardware detection and system maintenance",
    "homepage": "https://tubawinui3.cn",
    "license": {
        "identifier": "GPL-3.0-or-later"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/luolangaga/tubatools/releases/download/v1.5.0/TubaWinUi3_Portable_1.5.0_x64.zip",
            "hash": "fa700d8e256678e90339d34d371a964f2d6a4f81e731ca262396ba14efaff4c1"
        },
        "arm64": {
            "url": "https://github.com/luolangaga/tubatools/releases/download/v1.5.0/TubaWinUi3_Portable_1.5.0_arm64.zip",
            "hash": "c6b6f9431dca8fd917ddf5b37bc6605bdde19df0eeeb2c267bf71b2540d47d3f"
        }
    },
    "extract_to": "app",
    "post_install": [
        "# 数据目录 Junction 化：LocalAppData 路径 -> persist（首次/迁移时自动搬运已有数据）",
        "$link = \"$env:LocalAppData\\TubaWinUi3\"",
        "$dst = \"$persist_dir\\AppData\\Local\\TubaWinUi3\"",
        "if (Test-Path $link) {",
        "    $item = Get-Item $link -Force",
        "    if ($item.LinkType -eq 'Junction') {",
        "        $old = $item.Target",
        "        if ($old -ne $dst) { robocopy $old $dst /E /MOVE /R:1 /W:1 /NP /NFL /NDL /NJH /NJS | Out-Null }",
        "        Remove-Item $link -Force",
        "    } else {",
        "        robocopy $link $dst /E /MOVE /R:1 /W:1 /NP /NFL /NDL /NJH /NJS | Out-Null",
        "    }",
        "}",
        "New-Item -ItemType Junction -Path \"$env:LocalAppData\\TubaWinUi3\" -Target \"$persist_dir\\AppData\\Local\\TubaWinUi3\" | Out-Null"
    ],
    "pre_uninstall": [
        "Stop-Process -Name 'TubaWinUi3' -Force -ErrorAction SilentlyContinue",
        "if ((Test-Path \"$env:LocalAppData\\TubaWinUi3\") -and ((Get-Item \"$env:LocalAppData\\TubaWinUi3\" -Force).LinkType -eq 'Junction')) { Remove-Item \"$env:LocalAppData\\TubaWinUi3\" -Force }"
    ],
    "bin": [
        [
            "app\\src\\TubaWinUi3.exe",
            "tubatools"
        ]
    ],
    "shortcuts": [
        [
            "app\\src\\TubaWinUi3.exe",
            "图吧工具箱WinUi3"
        ]
    ],
    "persist": [
        "AppData\\Local\\TubaWinUi3"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/luolangaga/tubatools/releases/download/v$version/TubaWinUi3_Portable_$version_x64.zip"
            },
            "arm64": {
                "url": "https://github.com/luolangaga/tubatools/releases/download/v$version/TubaWinUi3_Portable_$version_arm64.zip"
            }
        }
    }
}
