{
    "version": "2.2.9",
    "description": "基于自定义规则的番剧采集 APP | A custom rule based anime collection APP",
    "homepage": "https://kazumi.app",
    "license": {
        "identifier": "GPL-3.0-or-later"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/Predidit/Kazumi/releases/download/2.2.9/Kazumi_windows_2.2.9.zip",
            "hash": "be65f7ddc5843800532cb90601b7931b3cf2b68026258e63890ad3cd0d0f7e6c"
        }
    },
    "extract_to": "app",
    "pre_install": [
        "# 关闭可能正在运行的旧版本进程，避免迁移时文件占用",
        "Stop-Process -Name 'kazumi' -Force -ErrorAction SilentlyContinue",
        "# 数据目录 Junction 化：AppData 路径 -> persist（首次/迁移时自动搬运已有数据）",
        "$link = \"$env:AppData\\com.example\\kazumi\"",
        "$dst = \"$persist_dir\\AppData\\Roaming\\com.example\\kazumi\"",
        "if (Test-Path $link) {",
        "    $item = Get-Item $link -Force",
        "    if ($item.LinkType -eq 'Junction') {",
        "        $old = $item.Target",
        "        if ($old -ne $dst) {",
        "            robocopy $old $dst /E /MOVE /R:1 /W:1 /NP /NFL /NDL /NJH /NJS | Out-Null",
        "            if ($LASTEXITCODE -ge 8) { Write-Host \"WARNING: migration failed (robocopy $LASTEXITCODE); keeping existing link.\" }",
        "            else { (Get-Item $link -Force).Delete() }",
        "        }",
        "    } else {",
        "        robocopy $link $dst /E /MOVE /R:1 /W:1 /NP /NFL /NDL /NJH /NJS | Out-Null",
        "        if ($LASTEXITCODE -ge 8) { Write-Host \"WARNING: migration failed (robocopy $LASTEXITCODE); original data kept in place.\" }",
        "    }",
        "}"
    ],
    "post_install": [
        "$link = \"$env:AppData\\com.example\\kazumi\"",
        "$dst = \"$persist_dir\\AppData\\Roaming\\com.example\\kazumi\"",
        "if (!(Test-Path $link)) { New-Item -ItemType Junction -Path $link -Target $dst | Out-Null }",
        "elseif ((Get-Item $link -Force).LinkType -eq 'Junction') { Write-Host \"Already linked: $link\" }",
        "else { Write-Host \"WARNING: $link exists as a real folder; junction skipped.\" }"
    ],
    "pre_uninstall": [
        "Stop-Process -Name 'kazumi' -Force -ErrorAction SilentlyContinue",
        "if ((Test-Path \"$env:AppData\\com.example\\kazumi\") -and ((Get-Item \"$env:AppData\\com.example\\kazumi\" -Force).LinkType -eq 'Junction')) { (Get-Item \"$env:AppData\\com.example\\kazumi\" -Force).Delete() }"
    ],
    "shortcuts": [
        [
            "app\\kazumi.exe",
            "kazumi"
        ]
    ],
    "persist": "AppData\\Roaming\\com.example\\kazumi",
    "checkver": {
        "github": "https://github.com/Predidit/Kazumi"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Predidit/Kazumi/releases/download/$version/Kazumi_windows_$version.zip"
            }
        }
    }
}
