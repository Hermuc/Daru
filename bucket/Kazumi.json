{
    "version": "2.2.7",
    "description": "基于自定义规则的番剧采集 APP | A custom rule based anime collection APP",
    "homepage": "https://kazumi.app",
    "license": {
        "identifier": "GPL-3.0-or-later"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/Predidit/Kazumi/releases/download/2.2.7/Kazumi_windows_2.2.7.zip",
            "hash": "80f591360f39bf108cfb82c7a537533afa8f495a236c8fb10ef834ef2b8a2728"
        }
    },
    "extract_to": "app",
    "pre_install": [
        "# 数据目录 Junction 化：AppData 路径 -> persist（首次/迁移时自动搬运已有数据）",
        "$link = \"$env:AppData\\com.example\\kazumi\"",
        "$dst = \"$persist_dir\\AppData\\Roaming\\com.example\\kazumi\"",
        "if (Test-Path $link) {",
        "    $item = Get-Item $link -Force",
        "    if ($item.LinkType -eq 'Junction') {",
        "        $old = $item.Target",
        "        if ($old -ne $dst) { robocopy $old $dst /E /MOVE /R:1 /W:1 /NP /NFL /NDL /NJH /NJS | Out-Null }",
        "        (Get-Item $link -Force).Delete()",
        "    } else {",
        "        robocopy $link $dst /E /MOVE /R:1 /W:1 /NP /NFL /NDL /NJH /NJS | Out-Null",
        "    }",
        "}"
    ],
    "post_install": "New-Item -ItemType Junction -Path \"$env:AppData\\com.example\\kazumi\" -Target \"$persist_dir\\AppData\\Roaming\\com.example\\kazumi\" | Out-Null",
    "pre_uninstall": [
        "Stop-Process -Name 'kazumi' -Force -ErrorAction SilentlyContinue",
        "if ((Test-Path \"$env:AppData\\com.example\\kazumi\") -and ((Get-Item \"$env:AppData\\com.example\\kazumi\" -Force).LinkType -eq 'Junction')) { (Get-Item \"$env:AppData\\com.example\\kazumi\" -Force).Delete() }"
    ],
    "shortcuts": [
        [
            "app\\kazumi.exe",
            "kazumi"
        ]
    ],
    "persist": "AppData\\Roaming\\com.example\\kazumi",
    "checkver": {
        "github": "https://github.com/Predidit/Kazumi"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Predidit/Kazumi/releases/download/$version/Kazumi_windows_$version.zip"
            }
        }
    }
}
